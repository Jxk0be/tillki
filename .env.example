# Copy to .env. Values come from the Supabase dashboard (Project Settings > API keys).
# Both are safe in the browser; row-level security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: a Google Books API key (Google Cloud Console > APIs & Services > Credentials,
# restricted to the Books API and your site's address). Without it, ISBN lookups
# often hit Google's shared quota and fall back to Open Library.
VITE_GOOGLE_BOOKS_API_KEY=
